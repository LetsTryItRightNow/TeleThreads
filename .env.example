# Telegram bot: admin of the channel, or a member (with access to messages) of the group
Telegram__BotToken=
# Channel or group id like -1001234567890 (the app logs ids of chats it ignores)
Telegram__ChannelId=

Gemini__ApiKey=
Gemini__Model=gemini-3.5-flash

# Keep true until the Threads account is connected via /threads/login
Threads__DryRun=true
# Meta app → Use cases → Access the Threads API → Settings: "Threads app ID" / "Threads app secret"
Threads__AppId=
Threads__AppSecret=

# Public address the photos are served from (Threads downloads them from here)
Media__PublicBaseUrl=https://telethreads.dergach.xyz

# Enables POST /api/test/posts (send the value in the X-Test-Key header); leave empty to disable
Testing__Key=

# MongoDB root user (created on the first start of the mongo container).
# Generate the password with: openssl rand -hex 16
MONGO_USER=telethreads
MONGO_PASSWORD=
